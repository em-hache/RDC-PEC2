<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#"
     xml:base="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:turismo="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo">
        <dc:name>Tourism Ontology</dc:name>
        <dc:title>Tourism Ontology</dc:title>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/name -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/name"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hostsPlaces -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hostsPlaces">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Place"/>
        <rdfs:comment>Lists the attractions that a city offers</rdfs:comment>
        <rdfs:label>hosts places</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#isLocatedIn -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#isLocatedIn">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#LocatedClass"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/City"/>
        <rdfs:comment>Indicates in which city is located the entity it is located at</rdfs:comment>
        <rdfs:label>is located in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#city_id -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#city_id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>General data property that contains the id of a city instance</rdfs:comment>
        <rdfs:label>city id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#date -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#date">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment>Data property that contains a date</rdfs:comment>
        <rdfs:label>date generic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#event_id -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#event_id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>General data property that contains the id of an event instance</rdfs:comment>
        <rdfs:label>event id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#good_value_hotel -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#good_value_hotel">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#good_value_restaurant -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#good_value_restaurant">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hotel_id -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hotel_id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>General data property that contains the id of a hotel instance</rdfs:comment>
        <rdfs:label>hotel id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hotel_type -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hotel_type">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Data property that indicates the type of hotel</rdfs:comment>
        <rdfs:label>hotel type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#isBeachCity -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#isBeachCity">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#location -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#location">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/City"/>
        <rdfs:comment>Holds the latitude and longitude of a location</rdfs:comment>
        <rdfs:label>location in coordenates</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#medium_price -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#medium_price">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Represents a price value</rdfs:comment>
        <rdfs:label>medium price generic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#name -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#name">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>General data property that contains the name of an instance</rdfs:comment>
        <rdfs:label>name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#nightly_rate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#nightly_rate">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Represents the price for a night in a hotel</rdfs:comment>
        <rdfs:label>hotel medium nightly rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#place_id -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#place_id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>General data property that contains the id of an attraction instance</rdfs:comment>
        <rdfs:label>attraction id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#place_type -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#place_type">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Place"/>
        <rdfs:comment>Data property that indicates the type of attraction</rdfs:comment>
        <rdfs:label>attraction type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#rating -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#rating">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>This property indicates the city where this entity is at</rdfs:comment>
        <rdfs:label>is located in</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#restaurant_id -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#restaurant_id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>General data property that contains the id of a restaurant instance</rdfs:comment>
        <rdfs:label>restaurant id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#restaurant_type -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#restaurant_type">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Restaurant"/>
        <rdfs:comment>Data property that indicates the type of restaurant</rdfs:comment>
        <rdfs:label>restaurant type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#stars -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#stars">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Represents the hotel category in the stars range</rdfs:comment>
        <rdfs:label>stars</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#transport_id -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#transport_id">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>General data property that contains the id of a transportation instance</rdfs:comment>
        <rdfs:label>transport id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#transport_type -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#transport_type">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Transport"/>
        <rdfs:comment>Data property that indicates the type of transportation</rdfs:comment>
        <rdfs:label>type of transportation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://dbpedia.org/ontology/Hotel -->


    <owl:Class rdf:about="http://dbpedia.org/ontology/Hotel"/>
    


    <!-- http://dbpedia.org/ontology/Museum -->


    <owl:Class rdf:about="http://dbpedia.org/ontology/Museum"/>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Andalusian -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Andalusian">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#restaurant_type"/>
                <owl:hasValue>Andaluza</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Restaurant"/>
        <rdfs:comment>Type of restaurant: andalusian cuisine</rdfs:comment>
        <rdfs:label>Andalusian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Beach -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Beach">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hotel_type"/>
                        <owl:hasValue>Playa</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Type of hotel: beach</rdfs:comment>
        <rdfs:label>Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Bicycle -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Bicycle">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#transport_type"/>
                <owl:hasValue>Bicicleta</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Transport"/>
        <rdfs:comment>Type of transportation: bicycle</rdfs:comment>
        <rdfs:label>Bicycle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Bus -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Bus">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#transport_type"/>
                <owl:hasValue>Autobús</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Transport"/>
        <rdfs:comment>Type of transportation: bus</rdfs:comment>
        <rdfs:label>Bus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Business -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Business">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#hotel_type"/>
                        <owl:hasValue>Negocios</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Type of hotel: business</rdfs:comment>
        <rdfs:label>Business Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Cultural -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Cultural">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#place_type"/>
                <owl:hasValue>Cultural</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Place"/>
        <rdfs:comment>Type of attraction: cultural</rdfs:comment>
        <rdfs:label>Cultural</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Event -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Event">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#LocatedClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#event_id"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Concept event</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#Hotel">
        <rdfs:subClassOf rdf:resource="http://dbpedia.org/ontology/Hotel"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#LocatedClass"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/elenamoreno/ontologies/2025/3/turismo#stars"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:oneOf>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
